<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- windowSoftInputMode="adjustResize": 키보드가 올라오면 화면(웹뷰)을 그만큼 «줄인다».
             이 값이 없으면 안드로이드가 화면을 밀어 올리기만 해서 로그인 폼이 키보드 뒤로 사라진다
             (2026-07-31 PO 실기기 확인 — 화면이 통째로 검게 남았다).
             캡시터 기본 매니페스트에도 이 값이 없어서 여태 비어 있었다. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 앱 링크(App Links) — healwith.co.kr 주소를 «앱이» 받는다 (2026-07-28 추가).
                 없으면 가입 인증 메일·상담방 초대 링크를 폰에서 눌러도 앱이 아니라 크롬이 열려서,
                 앱을 깔아둔 사람도 정작 상담은 앱 밖에서 하게 된다.
                 ⚠️ autoVerify 가 실제로 통과하려면 서버에 아래 파일이 있어야 한다:
                    https://healwith.co.kr/.well-known/assetlinks.json
                    (Play 콘솔 → 앱 서명 → SHA-256 지문을 넣어 발급. 지문 없이는 검증 실패 →
                     그때는 「기본으로 열기」를 사용자가 직접 켜야 한다.) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="healwith.co.kr" />
                <data android:scheme="https" android:host="www.healwith.co.kr" />
            </intent-filter>
        </activity>

        <!-- 알림 아이콘 — 상태표시줄은 «단색 실루엣»만 그린다. 지정이 없으면 런처 아이콘을
             통째로 뭉개서 «빈 동그라미»가 뜬다(2026-08-04 에뮬레이터에서 실제 확인).
             ic_stat_healwith 는 로고 앞면 겹의 알파에서 뽑은 흰 실루엣이다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_healwith" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 원격협진(LiveKit WebRTC) 영상·음성. 없으면 WebView getUserMedia 가 거부됨. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 푸시 알림(Android 13+, @capacitor/push-notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 카메라 없는 태블릿도 설치 가능하도록 (영상상담은 카메라 권장이나 필수 하드웨어로 잠그지 않음). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
