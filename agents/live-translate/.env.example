# Gemini Live Translate 통역 에이전트 환경변수
# 복사: cp .env.example .env.local 후 값 채우기

# LiveKit (메인 앱과 같은 프로젝트)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Gemini — ⚠️ 실환자 통역은 반드시 "유료 결제된" 키여야 함.
#   무료 등급 키 = 구글이 음성을 학습에 쓸 수 있음(환자 건강정보=레드라인).
#   테스트(내 목소리·가짜 대본)는 무료 키로 0원 가능.
GEMINI_API_KEY=your-gemini-api-key

# (선택) 모델 오버라이드 — 기본: gemini-3.5-live-translate-preview
# GEMINI_MODEL=gemini-3.5-live-translate-preview
