@echo off
chcp 65001 >nul
setlocal

REM ============================================================================
REM  자동으로_받기_끄기.cmd — 「자동으로_받기_켜기」로 등록한 작업을 지운다.
REM  되돌리기가 항상 한 번의 더블클릭으로 가능해야 해서 켜기와 짝으로 둔다.
REM ============================================================================

set TASKNAME=HEALO 자동 동기화

echo.
echo  ============================================
echo   자동으로 받기 - 끄기
echo  ============================================
echo.

schtasks /delete /tn "%TASKNAME%" /f >nul 2>nul
schtasks /delete /tn "%TASKNAME% (3시간마다)" /f >nul 2>nul

echo  [완료] 자동으로 받기를 껐습니다.
echo         이제부터는 «동기화.cmd» 를 더블클릭할 때만 받습니다.
echo.
pause
endlocal
