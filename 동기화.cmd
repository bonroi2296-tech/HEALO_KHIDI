@echo off
chcp 65001 >nul
setlocal

REM ============================================================================
REM  동기화.cmd — 더블클릭 한 번으로 «최신 받기».
REM
REM  왜 이 파일이 있나 (2026-07-27):
REM    PO 가 매번 명령 프롬프트를 열고 cd + npm run sync 를 타이핑해야 했다.
REM    비개발자에게 «명령어 두 줄»은 매번 부담이고, 안 하면 옛 파일을 보게 된다.
REM    → 폴더에서 이 파일을 더블클릭하면 끝나도록 만들었다.
REM
REM  하는 일: npm run sync 를 이 파일이 있는 폴더에서 실행하고, 결과를 보여준 뒤
REM           창이 바로 닫히지 않게 붙잡는다(더블클릭 시 결과를 못 보는 문제 방지).
REM  안전: sync 자체의 안전장치를 그대로 따른다 —
REM        본판(main)에서는 «내려받기만» 하고, 저장 안 된 남의 변경이 있으면 멈춘다.
REM ============================================================================

cd /d "%~dp0"

echo.
echo  ============================================
echo   HEALO 최신 받기
echo  ============================================
echo   폴더: %CD%
echo.

where npm >nul 2>nul
if errorlevel 1 (
  echo  [실패] npm 을 찾지 못했습니다.
  echo         Node.js 가 설치돼 있는지 확인해 주세요. https://nodejs.org
  echo.
  pause
  exit /b 1
)

call npm run sync
set RC=%ERRORLEVEL%

echo.
if "%RC%"=="0" (
  echo  ============================================
  echo   끝났습니다. 폴더에서 F5 를 눌러 새로고침하세요.
  echo  ============================================
) else (
  echo  ============================================
  echo   멈췄습니다. 위 내용을 그대로 클로드에게 보여주세요.
  echo  ============================================
)
echo.
pause
endlocal
