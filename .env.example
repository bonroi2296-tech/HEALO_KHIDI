# HEALO-KHIDI Environment Variables Example

# ============================================
# Database (Supabase)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Admin Authentication
# ============================================
# 쉼표로 구분된 관리자 이메일 목록
# ⚠️ 주의: 변수명은 ADMIN_EMAIL_ALLOWLIST 입니다 (ADMIN_EMAILS 아님)
ADMIN_EMAIL_ALLOWLIST=admin@healwith.co.kr,manager@healwith.co.kr

# ============================================
# AWS SES (Email Notifications)
# ============================================
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SES_FROM_EMAIL=noreply@healwith.co.kr

# ============================================
# Admin Notifications
# ============================================
# SMS는 아직 실제 발송하지 않음 (Mock mode)
# Email은 AWS SES로 실제 발송

# ENV Fallback (비상용 - 선택사항)
ADMIN_PHONE_NUMBERS=+821012345678,+821087654321

# ============================================
# Error Monitoring (Sentry) - 선택사항
# ============================================
# Sentry 프로젝트에서 DSN을 복사하세요
# https://sentry.io 에서 무료 계정 생성 가능
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org
# SENTRY_PROJECT=healo

# ============================================
# 시술 자동생성 (병원 웹사이트 크롤 + LLM 추출)
# ============================================
# 하나만 설정하면 됨 (Gemini 우선)
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key
# 화상상담 자막 실험(2026-09-05): 받아쓰기 «전용» 모델 Gemini 3.5 Transcribe 로 갈아끼운다.
# 비우면(기본) 기존 Flash 경로 그대로. 켜면 받아쓰기만 Interactions API, 번역은 Flash 유지.
# 실패하면 자동으로 Flash 경로로 떨어진다. 재는 법: docs/KNOWN_ISSUES.md 「2026-09-05 트렌드 스캔 발견」 ②
# STT_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# STT_TRANSCRIBE_VOCAB=면력한방병원,힐위드,코디네이터   # 용어 편향(쉼표 구분, ≤100). 효과 미검증
# STT_TRANSCRIBE_TIMEOUT_MS=10000    # 받아쓰기 호출 상한(ms). 넘기면 실패로 보고 Flash 경로로
# STT_TRANSCRIBE_COOLDOWN_MS=60000   # 실패 뒤 실험을 건너뛰는 시간(ms)
# OPENAI_API_KEY=your-openai-key

# HIRA 공공 API (공공데이터포털에서 발급, 자동승인)
# 챗봇이 DB에 없는 병원을 공공데이터에서 검색할 때 사용
# HIRA_API_KEY=your-hira-api-key

# 네이버 검색 (developers.naver.com에서 발급)
# 챗봇 병원 검색 보강 + 수집량 부족 시 병원명으로 검색
# NAVER_CLIENT_ID=your-naver-client-id
# NAVER_CLIENT_SECRET=your-naver-client-secret

# ============================================
# RAG / 챗봇 (선택)
# ============================================
# true 이면 RAG 검색 비활성화 (장애 시 사용)
# RAG_DISABLED=false

# ============================================
# Messenger Channels (문의 페이지 연결)
# ============================================
# WhatsApp: https://wa.me/821012345678 (82 + 국가코드 제외한 전화번호)
# LINE: https://line.me/R/ti/p/@your-line-handle 또는 https://line.me/ti/p/~your-line-handle
# WeChat: https://weixin.qq.com/r/xxxx 또는 QR 링크
# NEXT_PUBLIC_MESSENGER_WHATSAPP_URL=https://wa.me/821012345678
# NEXT_PUBLIC_MESSENGER_LINE_URL=https://line.me/R/ti/p/@your-line-handle
# NEXT_PUBLIC_MESSENGER_WECHAT_URL=

# ============================================
# LiveKit (WebRTC 화상 상담)
# ============================================
# https://livekit.io/cloud 에서 무료 계정 생성
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ── 실시간 통역(Gemini Live Translate) 스위치 ── 기본값 꺼짐.
# 꺼져 있으면 상담방은 기존 동작 100% 동일(기존 STT 자막). 켜기 = 오픈 전 3단계:
#   1) 통역 에이전트 배포(agents/live-translate) + 유료 GEMINI_API_KEY
#   2) 아래 두 스위치 true
#   3) 실 2인 통화 검증
# 상세: docs/LIVE_TRANSLATE_SETUP.md
LIVE_TRANSLATE_ENABLED=false
NEXT_PUBLIC_LIVE_TRANSLATE_ENABLED=false

# ============================================
# Internal API Security
# ============================================
# API 라우트 보호용 비밀키 (랜덤 문자열)
INTERNAL_ADMIN_SECRET=generate-strong-random-secret
INTERNAL_API_SECRET=generate-strong-random-secret

# Vercel Cron 보호용 비밀키
CRON_SECRET=generate-strong-cron-secret

# ============================================
# Google Maps (병원 지도)
# ============================================
# 이 값이 없으면 병원 상세의 지도 자리에 «회색 위치 상자»(이름+주소 글자)가 대신 나온다.
# 그건 고장이 아니라 의도된 대체 화면이지만, 켜려던 걸 잊으면 조용히 꺼진 채로 남는다.
# 2026-08-14 실측: 실서비스에 이 값이 «안 들어가 있어» 지도가 안 뜨는 상태였다.
# ⚠️ 켤 때는 반드시 구글 클라우드 콘솔에서 «사용처 제한»(우리 도메인만)부터 걸 것.
#    이 값은 브라우저로 그대로 나가는 공개 값이라, 제한이 없으면 남이 쓰고 우리에게 청구된다.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# ============================================
# Google Analytics
# ============================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# 얀덱스 Metrica 카운터 ID, 없으면 비활성 (러시아/CIS 시장). 쿠키 동의 "Accept All" 시에만 로드.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://healwith.co.kr
ADMIN_DASHBOARD_URL=http://localhost:3000

# ── AI 비용 가드 (토큰 남용 방어) ──
# 공개 AI 엔드포인트의 IP당 일일 호출 상한 (기본 50)
# AI_DAILY_PER_IP_LIMIT=50
# 전역 일일 AI 호출 총량 — 초과 시 공개 AI 일시 중단 + Sentry 경보 (기본 2000)
# AI_DAILY_GLOBAL_LIMIT=2000
# ── 상담방 실시간 통역·STT 비용 가드 (공개챗과 별개 — 상담 안 끊는 높은 천장) ──
# 발화마다 Gemini 를 부르는 실시간 통역/STT 의 폭주(루프·봇·오작동) backstop. 정상 상담은 안 걸림.
# ⚠️ 0순위 하드캡은 Google Cloud spend cap(콘솔). 유료 Gemini 키 연결 '전에' 그것부터 설정할 것.
# 한 상담(세션)당 일일 호출 상한 (기본 5000 — 매우 긴 상담도 안 걸리는 값)
# AI_CONSULT_SESSION_DAILY=5000
# 전 상담 합산 일일 호출 상한 (기본 30000)
# AI_CONSULT_GLOBAL_DAILY=30000

# ── KHIDI 테스트/실제 데이터 분리 (평가 KPI 오염 방지) ──
# 문의 생성 시 아래에 해당하면 '테스트'로 표시(inquiries.is_test=true) → KPI·전환깔때기·증빙·만족도에서 기본 제외.
# 1) 사무실 공인 IP (콤마구분). 이 IP에서 만든 문의는 자동 테스트. 비우면 IP 자동분리 끔(이메일·수동도장은 계속 동작).
#    ⚠️ 유동IP면 바뀔 수 있음 — 바뀌면 갱신. 클릭 IP가 아니라 '문의 생성 시점' IP만 봄(코디 진짜유치 안 빠짐).
# TEST_OFFICE_IPS=203.0.113.5,203.0.113.6
# 2) 테스트 이메일 도메인 (콤마구분, 기본 test.com). 예: anything@test.com 으로 테스트하면 자동 제외.
# TEST_EMAIL_DOMAINS=test.com

# ── E2E 테스트 계정 (자동 검사 전용 — 실제 환자 PII 금지, 더미 계정만) ──
# 왜 여기에 적나(2026-07-28): 이 키들이 어디에도 안 적혀 있어서 «이런 장치가 있다»는 사실
# 자체를 새로 세팅하는 사람이 몰랐다. 실제로 `hospital` 역할은 목록에서 통째로 빠져 있었고,
# 그 결과 국내 병원 백오피스 화면을 몇 세션 동안 «계정 접근 불가»로 못 보고 넘어갔다.
#
# 동작: `e2e/auth.setup.ts` 가 역할당 1회만 로그인해 세션(쿠키)을 파일로 저장하고,
#       각 테스트는 그 쿠키만 주입한다(공유 Supabase 부하 방지 — POSTMORTEMS #117).
#       키가 없는 역할은 그 역할 스펙째로 조용히 스킵된다 = 안 넣으면 «검사가 없는 것».
# 실서비스 자동 검사에 넣으려면 GitHub Actions Secrets 에도 같은 이름으로 등록 (docs/E2E_SECRETS_SETUP.md).
#
# E2E_TEST_USER_EMAIL=      # 환자
# E2E_TEST_USER_PASSWORD=
# E2E_ADMIN_EMAIL=          # 어드민
# E2E_ADMIN_PASSWORD=
# E2E_COORDINATOR_EMAIL=    # 코디네이터
# E2E_COORDINATOR_PASSWORD=
# E2E_AGENCY_EMAIL=         # 해외 에이전시
# E2E_AGENCY_PASSWORD=
# E2E_CLINIC_EMAIL=         # 해외 의료기관
# E2E_CLINIC_PASSWORD=
# E2E_HOSPITAL_EMAIL=       # 국내 병원 (2026-07-28 추가 — 유일하게 빠져 있던 역할)
# E2E_HOSPITAL_PASSWORD=
