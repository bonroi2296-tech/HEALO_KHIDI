# HEALO Environment Variables Example

# ============================================
# Database (Supabase)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Admin Authentication
# ============================================
# 쉼표로 구분된 관리자 이메일 목록
# ⚠️ 주의: 변수명은 ADMIN_EMAIL_ALLOWLIST 입니다 (ADMIN_EMAILS 아님)
ADMIN_EMAIL_ALLOWLIST=admin@healo.com,manager@healo.com

# ============================================
# AWS SES (Email Notifications)
# ============================================
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SES_FROM_EMAIL=noreply@healo.com

# ============================================
# Admin Notifications
# ============================================
# SMS는 아직 실제 발송하지 않음 (Mock mode)
# Email은 AWS SES로 실제 발송

# ENV Fallback (비상용 - 선택사항)
ADMIN_PHONE_NUMBERS=+821012345678,+821087654321

# ============================================
# Error Monitoring (Sentry) - 선택사항
# ============================================
# Sentry 프로젝트에서 DSN을 복사하세요
# https://sentry.io 에서 무료 계정 생성 가능
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org
# SENTRY_PROJECT=healo

# ============================================
# 시술 자동생성 (병원 웹사이트 크롤 + LLM 추출)
# ============================================
# 하나만 설정하면 됨 (Gemini 우선)
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key
# OPENAI_API_KEY=your-openai-key

# HIRA 공공 API (공공데이터포털에서 발급, 자동승인)
# 챗봇이 DB에 없는 병원을 공공데이터에서 검색할 때 사용
# HIRA_API_KEY=your-hira-api-key

# 네이버 검색 (developers.naver.com에서 발급)
# 챗봇 병원 검색 보강 + 수집량 부족 시 병원명으로 검색
# NAVER_CLIENT_ID=your-naver-client-id
# NAVER_CLIENT_SECRET=your-naver-client-secret

# ============================================
# RAG / 챗봇 (선택)
# ============================================
# true 이면 RAG 검색 비활성화 (장애 시 사용)
# RAG_DISABLED=false

# ============================================
# Messenger Channels (문의 페이지 연결)
# ============================================
# WhatsApp: https://wa.me/821012345678 (82 + 국가코드 제외한 전화번호)
# LINE: https://line.me/R/ti/p/@healo 또는 https://line.me/ti/p/~healo
# WeChat: https://weixin.qq.com/r/xxxx 또는 QR 링크
# NEXT_PUBLIC_MESSENGER_WHATSAPP_URL=https://wa.me/821012345678
# NEXT_PUBLIC_MESSENGER_LINE_URL=https://line.me/R/ti/p/@healo
# NEXT_PUBLIC_MESSENGER_WECHAT_URL=

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:3000
